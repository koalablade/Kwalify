# Copy to .env and fill in values. See docs/environment-variables.md for details.

DATABASE_URL=postgresql://kwalify:kwalify@localhost:5432/kwalify
SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters
PORT=5000

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://kwalify.net/api/auth/callback

NODE_ENV=development
APP_URL=https://kwalify.net
BIND_HOST=0.0.0.0
# Self-host (closed beta from your PC): run setup-self-host.bat once, then start.bat (Desktop: Start Kwalify)
# KWALIFY_HOST_MODE=selfhost
# KWALIFY_EXPOSURE=cloudflare
# LOG_LEVEL=info
# OPS_METRICS_TOKEN=  # Auto-generated on first Start Kwalify if empty; use /status?ops=TOKEN
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=beta
# SENTRY_TRACES_SAMPLE_RATE=0.1
# KWALIFY_STRICT_NODE=1  # Refuse start on non-Node-20 when set
# Self-host production capacity (8-core PC):
# V3_PARALLEL_WORKERS=4
# GENERATE_CONCURRENCY_LIMIT=2
# GENERATE_QUEUE_LIMIT=4
#
# Compound-intent pipeline (V39–V41; required for production — auto-set by start.bat on selfhost):
# PLAYLIST_CONTRACT_WORLD_GATE=1
# PLAYLIST_CONTRACT_V40=1
# PLAYLIST_CONTRACT_V41=1
# Optional diagnostics:
# PLAYLIST_CONTRACT_SHADOW=1
# PLAYLIST_CONTRACT_RETRIEVAL=1
# PLAYLIST_CONTRACT_VALIDATION=shadow
# PLAYLIST_EVAL_TOKEN=
# SMOKE_SPOTIFY_USER_ID=
# EVAL_ALLOWED_SPOTIFY_USER_IDS=
# FRONTEND_URL=https://www.kwalify.net
