# Copy to deploy/cloudflared.yml and fill in tunnel ID + credentials path.
# Setup: cloudflared tunnel login && cloudflared tunnel create kwalify
#        cloudflared tunnel route dns kwalify kwalify.yourdomain.com

tunnel: REPLACE_WITH_TUNNEL_ID
credentials-file: C:\Users\YOU\.cloudflared\REPLACE_WITH_TUNNEL_ID.json

ingress:
  - hostname: kwalify.yourdomain.com
    service: http://127.0.0.1:5000
  - service: http_status:404
